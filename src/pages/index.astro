---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { HOME_TITLE } from '../consts';
import { allModels, formatContext, formatPrice, getRegionLabel, getModelLogo } from '../data/models';
import { allNews, formatShortDate } from '../data/news';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured?.id).slice(0, 6);
const topModelsPreview = [
  ...allModels.filter((m) => m.region === 'global').slice(0, 3),
  ...allModels.filter((m) => m.region === 'china').slice(0, 3),
];
const latestNewsPreview = allNews.slice(0, 6);

const topics = ['提示词工程', '大模型原理', 'RAG', 'AI Agent', 'AI 工具实测'];
---

<BaseLayout fullTitle={HOME_TITLE}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-white/5">
    <div class="mx-auto max-w-5xl px-4 py-20 sm:py-28">
      <div class="reveal">
        <span class="eyebrow">// AI · Notes · Lab</span>
      </div>

      <h1 class="reveal mt-5 max-w-3xl text-4xl font-extrabold leading-[1.1] tracking-tight sm:text-6xl">
        探索 <span class="gradient-text">人工智能</span> 的<br class="hidden sm:block" />
        原理、工具与实践
      </h1>

      <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-muted">
        记录我在学习 AI 路上的思考与实践：提示词工程、大模型原理、RAG、AI Agent，
        以及各类 AI 工具的实测与使用经验。写给自己，也希望帮到你。
      </p>

      <div class="reveal mt-9 flex flex-wrap items-center gap-4">
        <a href="/models/" class="btn-glow">
          查看 AI 大模型排行榜
          <span aria-hidden="true">→</span>
        </a>
        <a href="/news/" class="btn-ghost">今日 AI 热点</a>
        <a href="/blog/" class="btn-ghost">浏览全部文章</a>
      </div>

      <!-- 主题标签行 -->
      <div class="reveal mt-10 flex flex-wrap gap-2.5">
        {topics.map((t) => <span class="chip">{t}</span>)}
      </div>

      <!-- 数据条 -->
      <div class="reveal mt-14 grid max-w-2xl grid-cols-3 gap-4">
        <div class="glass rounded-2xl px-3 py-3 sm:px-5 sm:py-4">
          <div class="text-2xl font-extrabold text-ink sm:text-3xl">{posts.length}</div>
          <div class="mt-1 text-xs text-muted">篇文章</div>
        </div>
        <div class="glass rounded-2xl px-3 py-3 sm:px-5 sm:py-4">
          <div class="text-2xl font-extrabold text-ink sm:text-3xl">
            {new Set(posts.flatMap((p) => p.data.tags)).size}
          </div>
          <div class="mt-1 text-xs text-muted">个主题</div>
        </div>
        <div class="glass rounded-2xl px-3 py-3 sm:px-5 sm:py-4">
          <div class="text-2xl font-extrabold gradient-text sm:text-3xl">∞</div>
          <div class="mt-1 text-xs text-muted">持续更新</div>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 py-16">
    <!-- AI 实时热点速递 -->
    <section class="reveal mb-16">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="eyebrow">Live AI News</span>
          <h2 class="mt-2 text-2xl font-bold text-ink">AI 实时热点快讯</h2>
        </div>
        <a href="/news/" class="text-sm font-medium text-neon-cyan hover:underline">
          查看全部 {allNews.length} 条 AI 动态 →
        </a>
      </div>

      <div class="grid gap-3.5 md:grid-cols-2">
        {
          latestNewsPreview.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="card group flex flex-col justify-between p-4"
            >
              <div class="flex items-center justify-between gap-2 text-xs">
                <span
                  class:list={[
                    'rounded-full px-2 py-0.5 font-medium',
                    item.region === 'china'
                      ? 'bg-emerald-500/15 text-emerald-300'
                      : 'bg-brand-500/15 text-brand-200',
                  ]}
                >
                  {item.sourceName}
                </span>
                <time datetime={item.publishedAt} class="font-mono text-muted">
                  {formatShortDate(item.publishedAt)}
                </time>
              </div>
              <h3 class="mt-2 line-clamp-2 text-sm font-semibold leading-snug text-ink transition-colors group-hover:text-neon-cyan">
                {item.title}
              </h3>
            </a>
          ))
        }
      </div>
    </section>

    <!-- 2026 AI 大模型排行榜精选入口 -->
    <section class="reveal mb-16">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="eyebrow">2026 Leaderboard</span>
          <h2 class="mt-2 text-2xl font-bold text-ink">国内外 AI 大模型排行榜速览</h2>
        </div>
        <a href="/models/" class="text-sm font-medium text-neon-cyan hover:underline">
          按场景选型 & 完整 {allModels.length} 款对比 →
        </a>
      </div>

      <div class="mb-5 flex flex-wrap items-center gap-2 text-xs">
        <span class="text-muted">按需求找模型：</span>
        <a href="/models/use-case/writing/" class="chip">✍️ 写文章</a>
        <a href="/models/use-case/ppt/" class="chip">📊 做 PPT / 写方案</a>
        <a href="/models/use-case/coding/" class="chip">💻 写代码</a>
        <a href="/models/use-case/long-doc/" class="chip">📚 读长文档</a>
        <a href="/models/use-case/cost-effective/" class="chip">💰 省钱 API</a>
        <a href="/models/use-case/china-direct/" class="chip">🇨🇳 国内直连</a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          topModelsPreview.map((m) => (
            <a href={`/models/${m.slug}/`} class="card group p-5">
              <div class="flex items-center justify-between text-xs">
                <span class="font-mono font-bold text-neon-cyan">#{m.rank} · Elo {m.arenaElo}</span>
                <span class="rounded-full bg-white/5 px-2 py-0.5 text-[11px] text-slate-300">
                  {getRegionLabel(m.region)}
                </span>
              </div>
              <div class="mt-2.5 flex items-center gap-2.5">
                <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl border border-white/10 bg-white/[0.06] p-1.5">
                  <img
                    src={getModelLogo(m.provider)}
                    alt={`${m.provider} Logo`}
                    width="24"
                    height="24"
                    loading="lazy"
                    class="h-6 w-6 object-contain"
                  />
                </span>
                <div class="min-w-0">
                  <h3 class="truncate text-base font-bold text-ink transition-colors group-hover:text-neon-cyan">
                    {m.name}
                  </h3>
                  <p class="truncate text-xs text-muted">{m.providerZh}</p>
                </div>
              </div>
              <p class="mt-2 text-xs text-muted">
                {formatContext(m.contextLength)} 上下文 · {formatPrice(m.inputPricePerM)}/{formatPrice(m.outputPricePerM)}
              </p>
              <p class="mt-2.5 line-clamp-2 text-xs leading-relaxed text-slate-300">{m.summary}</p>
            </a>
          ))
        }
      </div>
    </section>

    {
      featured && (
        <a
          href={`/blog/${featured.id}/`}
          class="card reveal group mb-14 grid overflow-hidden md:grid-cols-2"
        >
          {featured.data.cover ? (
            <img
              src={featured.data.cover}
              alt={featured.data.title}
              width="1200"
              height="750"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="aspect-[16/10] w-full object-cover opacity-90 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-100 md:aspect-auto md:h-full"
            />
          ) : (
            <div class="relative flex aspect-[16/10] items-center justify-center overflow-hidden bg-gradient-to-br from-brand-700/40 via-surface to-neon-violet/25 text-3xl font-bold md:aspect-auto">
              <span class="gradient-text">{featured.data.tags[0] ?? '精选'}</span>
              <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,rgba(120,160,255,0.08)_1px,transparent_1px),linear-gradient(to_bottom,rgba(120,160,255,0.08)_1px,transparent_1px)] bg-[size:32px_32px]" />
            </div>
          )}
          <div class="flex flex-col justify-center p-8">
            <span class="eyebrow">置顶阅读</span>
            <h2 class="mt-3 text-2xl font-bold leading-snug text-ink transition-colors group-hover:text-neon-cyan">
              {featured.data.title}
            </h2>
            <p class="mt-3 line-clamp-3 text-muted">{featured.data.description}</p>
            <span class="mt-5 text-sm font-semibold text-neon-cyan">阅读全文 →</span>
          </div>
        </a>
      )
    }

    <div class="reveal mb-8 flex items-end justify-between">
      <div>
        <span class="eyebrow">Latest</span>
        <h2 class="mt-2 text-2xl font-bold text-ink">最新文章</h2>
      </div>
      <a href="/blog/" class="text-sm font-medium text-neon-cyan hover:underline">
        查看全部 →
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
