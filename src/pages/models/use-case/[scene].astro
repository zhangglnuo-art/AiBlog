---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE_URL, SITE_NAME } from '../../../consts';
import {
  modelsDataset,
  formatContext,
  formatPrice,
  formatModality,
  getLicenseLabel,
  getRegionLabel,
  getTierLabel,
} from '../../../data/models';
import { SCENARIOS, getRankedModelsForScenario, type ScenarioGuide } from '../../../data/scenarios';

export function getStaticPaths() {
  return SCENARIOS.map((scenario) => ({
    params: { scene: scenario.slug },
    props: { scenario },
  }));
}

interface Props {
  scenario: ScenarioGuide;
}

const { scenario } = Astro.props;
const ranked = getRankedModelsForScenario(scenario);
const updatedDate = modelsDataset.updatedAt.slice(0, 10);

const topOverall = ranked[0];
const topChina = ranked.find((r) => r.model.region === 'china') ?? ranked[1] ?? ranked[0];
const topBudget =
  [...ranked]
    .filter((r) => r.model.blendedPricePerM != null)
    .sort((a, b) => (a.model.blendedPricePerM ?? 999) - (b.model.blendedPricePerM ?? 999))[0] ??
  ranked[0];

const canonicalUrl = new URL(`/models/use-case/${scenario.slug}/`, SITE_URL).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: scenario.seoTitle,
    description: scenario.seoDescription,
    url: canonicalUrl,
    numberOfItems: ranked.length,
    itemListOrder: 'https://schema.org/ItemListOrderAscending',
    itemListElement: ranked.map((item, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: `${item.model.name} (${item.model.provider})`,
      url: new URL(`/models/${item.model.slug}/`, SITE_URL).href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: scenario.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: 'AI 大模型排行榜', item: new URL('/models/', SITE_URL).href },
      { '@type': 'ListItem', position: 3, name: scenario.shortName, item: canonicalUrl },
    ],
  },
];
---

<BaseLayout fullTitle={`${scenario.seoTitle} | ${SITE_NAME}`} description={scenario.seoDescription} jsonLd={jsonLd}>
  <article class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
    <!-- 面包屑 -->
    <nav class="mb-6 flex flex-wrap items-center gap-2 text-xs text-muted" aria-label="面包屑导航">
      <a href="/" class="hover:text-neon-cyan">首页</a>
      <span>/</span>
      <a href="/models/" class="hover:text-neon-cyan">AI 大模型排行榜</a>
      <span>/</span>
      <span class="text-slate-300">{scenario.shortName}</span>
    </nav>

    <!-- 顶部 Header -->
    <header class="glass rounded-3xl p-6 sm:p-8">
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <span class="eyebrow">Scenario Leaderboard · {updatedDate} 更新</span>
      </div>

      <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-ink sm:text-4xl">
        <span class="mr-2" aria-hidden="true">{scenario.icon}</span>
        {scenario.seoTitle}
      </h1>

      <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-300">{scenario.intro}</p>

      <!-- 三大快捷结论卡 -->
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {
          topOverall && (
            <a href={`/models/${topOverall.model.slug}/`} class="card group p-4">
              <div class="text-xs font-semibold text-neon-cyan">🏆 场景综合首选 · 适配分 {topOverall.score}</div>
              <div class="mt-1.5 text-lg font-bold text-ink group-hover:text-neon-cyan">{topOverall.model.name}</div>
              <div class="mt-1 text-xs text-muted">
                {topOverall.model.providerZh} · {formatPrice(topOverall.model.inputPricePerM)} / {formatPrice(topOverall.model.outputPricePerM)}
              </div>
              <p class="mt-2 text-xs leading-relaxed text-slate-300">{topOverall.reason}</p>
            </a>
          )
        }
        {
          topChina && (
            <a href={`/models/${topChina.model.slug}/`} class="card group p-4">
              <div class="text-xs font-semibold text-emerald-300">🇨🇳 国内直连首选 · 适配分 {topChina.score}</div>
              <div class="mt-1.5 text-lg font-bold text-ink group-hover:text-neon-cyan">{topChina.model.name}</div>
              <div class="mt-1 text-xs text-muted">
                {topChina.model.providerZh} · {topChina.model.chinaAccess}
              </div>
              <p class="mt-2 text-xs leading-relaxed text-slate-300">{topChina.reason}</p>
            </a>
          )
        }
        {
          topBudget && (
            <a href={`/models/${topBudget.model.slug}/`} class="card group p-4">
              <div class="text-xs font-semibold text-amber-300">💰 高性价比省钱之选 · 适配分 {topBudget.score}</div>
              <div class="mt-1.5 text-lg font-bold text-ink group-hover:text-neon-cyan">{topBudget.model.name}</div>
              <div class="mt-1 text-xs text-muted">
                输入 {formatPrice(topBudget.model.inputPricePerM)} / 输出 {formatPrice(topBudget.model.outputPricePerM)} (每百万)
              </div>
              <p class="mt-2 text-xs leading-relaxed text-slate-300">{topBudget.reason}</p>
            </a>
          )
        }
      </div>
    </header>

    <!-- 场景完整排行榜表格 -->
    <section class="mt-10">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="eyebrow">Ranked Models</span>
          <h2 class="mt-2 text-2xl font-bold text-ink">{scenario.name} · 推荐大模型榜单（共 {ranked.length} 款）</h2>
        </div>
        <a href={`/models/?scene=${scenario.slug}#wizard`} class="text-sm font-medium text-neon-cyan hover:underline">
          去选型器按预算/地区细筛 →
        </a>
      </div>

      <div class="mt-4 overflow-x-auto rounded-2xl border border-white/10 bg-white/[0.02]">
        <table class="w-full min-w-[820px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-white/10 bg-white/[0.03] text-xs uppercase tracking-wider text-muted">
              <th class="px-3 py-3.5 w-16">榜次</th>
              <th class="px-4 py-3.5">模型 / 厂商</th>
              <th class="px-3 py-3.5">场景适配分</th>
              <th class="px-3 py-3.5">综合 Elo</th>
              <th class="px-3 py-3.5">上下文</th>
              <th class="px-3 py-3.5">输入 / 输出价 (1M)</th>
              <th class="px-4 py-3.5">为什么适合此场景</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            {
              ranked.map((item, idx) => (
                <tr class="transition-colors hover:bg-white/[0.04]">
                  <td class="px-3 py-3.5 font-mono font-bold">
                    <span
                      class:list={[
                        'inline-flex h-7 w-7 items-center justify-center rounded-lg text-xs',
                        idx < 3
                          ? 'bg-gradient-to-br from-neon-cyan/30 to-brand-500/40 text-neon-cyan ring-1 ring-neon-cyan/40'
                          : 'bg-white/5 text-muted',
                      ]}
                    >
                      #{idx + 1}
                    </span>
                  </td>
                  <td class="px-4 py-3.5">
                    <div class="flex flex-wrap items-center gap-2">
                      <a href={`/models/${item.model.slug}/`} class="font-semibold text-ink hover:text-neon-cyan hover:underline">
                        {item.model.name}
                      </a>
                      <span
                        class:list={[
                          'rounded-full px-2 py-0.5 text-[11px]',
                          item.model.region === 'china'
                            ? 'bg-emerald-500/15 text-emerald-300'
                            : 'bg-brand-500/15 text-brand-200',
                        ]}
                      >
                        {getRegionLabel(item.model.region)}
                      </span>
                    </div>
                    <div class="mt-0.5 text-xs text-muted">
                      {item.model.providerZh} · {getLicenseLabel(item.model.license)} · {getTierLabel(item.model.tier)}
                    </div>
                  </td>
                  <td class="px-3 py-3.5 font-mono">
                    <span class="font-bold text-neon-cyan">{item.score}</span>
                    <span class="text-xs text-muted"> / 100</span>
                  </td>
                  <td class="px-3 py-3.5 font-mono text-slate-200">{item.model.arenaElo}</td>
                  <td class="px-3 py-3.5 font-mono text-slate-200">{formatContext(item.model.contextLength)}</td>
                  <td class="px-3 py-3.5 font-mono text-xs text-slate-200">
                    <div>{formatPrice(item.model.inputPricePerM)} / M</div>
                    <div class="text-muted">{formatPrice(item.model.outputPricePerM)} / M</div>
                  </td>
                  <td class="px-4 py-3.5 text-xs leading-relaxed text-slate-300 max-w-xs">
                    <p>{item.reason}</p>
                    <div class="mt-1 flex flex-wrap gap-1">
                      {item.model.modalities.map((mod) => (
                        <span class="rounded bg-white/5 px-1.5 py-0.5 text-[10px] text-slate-400">
                          {formatModality(mod)}
                        </span>
                      ))}
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- 选型建议 & 相关教程 -->
    <section class="mt-10 grid gap-6 lg:grid-cols-2">
      <div class="card p-6">
        <span class="eyebrow">Practical Advice</span>
        <h2 class="mt-2 text-xl font-bold text-ink">{scenario.shortName} · 实用选型建议</h2>
        <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-slate-300">
          {
            scenario.selectionTips.map((tip) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-neon-cyan">•</span>
                <span>{tip}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="card p-6">
        <span class="eyebrow">Related Guides</span>
        <h2 class="mt-2 text-xl font-bold text-ink">配套教程与进阶阅读</h2>
        <div class="mt-4 space-y-3">
          {
            scenario.relatedPosts.map((post) => (
              <a
                href={post.href}
                class="flex items-center justify-between rounded-xl border border-white/8 bg-white/[0.03] px-4 py-3 text-sm font-medium text-ink transition hover:border-neon-cyan/40 hover:text-neon-cyan"
              >
                <span>{post.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 场景 FAQ -->
    {
      scenario.faqs.length > 0 && (
        <section class="mt-10">
          <span class="eyebrow">FAQ</span>
          <h2 class="mt-2 text-xl font-bold text-ink">{scenario.shortName}常见问题</h2>
          <div class="mt-4 space-y-3">
            {scenario.faqs.map((item) => (
              <details class="glass group rounded-2xl p-5" open>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink">
                  <span>{item.q}</span>
                  <span class="text-neon-cyan transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-slate-300">{item.a}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    <!-- 切换其他场景榜单（站内互链矩阵） -->
    <section class="mt-12 border-t border-white/8 pt-8">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h2 class="text-lg font-bold text-ink">按其他使用场景找大模型</h2>
        <a href="/models/" class="text-sm text-neon-cyan hover:underline">返回完整总榜与对比器 →</a>
      </div>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          SCENARIOS.map((s) => (
            <a
              href={`/models/use-case/${s.slug}/`}
              class:list={[
                'rounded-xl border p-3.5 text-sm transition',
                s.slug === scenario.slug
                  ? 'border-neon-cyan/60 bg-neon-cyan/10 text-neon-cyan'
                  : 'border-white/8 bg-white/[0.02] text-slate-300 hover:border-neon-cyan/40 hover:text-ink',
              ]}
            >
              <div class="font-semibold">
                <span class="mr-1.5" aria-hidden="true">{s.icon}</span>
                {s.shortName}
              </div>
              <div class="mt-1 line-clamp-1 text-xs text-muted">{s.tagline}</div>
            </a>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>
