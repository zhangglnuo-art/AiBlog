  <style>
    .filter-btn {
      border-radius: 0.65rem;
      padding: 0.3rem 0.7rem;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--color-muted);
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .filter-btn:hover {
      color: var(--color-ink);
      border-color: rgba(56, 232, 255, 0.35);
    }
    .filter-btn.is-active {
      color: var(--color-neon-cyan);
      background: rgba(56, 232, 255, 0.12);
      border-color: rgba(56, 232, 255, 0.45);
    }
  </style>

  <script is:inline define:vars={{ comparePayload }}>
    (() => {
      const state = {
        region: 'all',
        license: 'all',
        tier: 'all',
        search: '',
        sort: 'elo-desc',
      };

      const defaultSelected = ['gemini-4-carbon', 'claude-opus-5-5', 'deepseek-v4-pro'];
      let selectedSlugs = [...defaultSelected];

      const tbody = document.getElementById('leaderboard-tbody');
      const rows = Array.from(document.querySelectorAll('.model-row'));
      const countEl = document.getElementById('visible-count');
      const searchInput = document.getElementById('model-search');
      const sortSelect = document.getElementById('model-sort');
      const compareGrid = document.getElementById('compare-grid');
      const resetBtn = document.getElementById('compare-reset');
      const checkboxes = Array.from(document.querySelectorAll('.compare-checkbox'));

      const modelMap = new Map(comparePayload.map((m) => [m.slug, m]));

      function syncCheckboxes() {
        checkboxes.forEach((cb) => {
          cb.checked = selectedSlugs.includes(cb.value);
        });
      }

      function renderCompare() {
        if (!compareGrid) return;
        const list = selectedSlugs.map((s) => modelMap.get(s)).filter(Boolean);
        if (!list.length) {
          compareGrid.innerHTML =
            '<div class="glass col-span-full rounded-2xl p-6 text-center text-sm text-muted">请在上方排行榜勾选 1–3 款模型进行对比。</div>';
          return;
        }
        compareGrid.innerHTML = list
          .map(
            (m) => `
          <article class="card flex flex-col justify-between p-5">
            <div>
              <div class="flex items-start justify-between gap-2">
                <div>
                  <span class="text-xs font-mono text-neon-cyan">#${m.rank} · ${m.regionLabel} · ${m.licenseLabel}</span>
                  <h3 class="mt-1 text-lg font-bold text-ink">
                    <a href="/models/${m.slug}/" class="hover:text-neon-cyan">${m.name}</a>
                  </h3>
                  <div class="text-xs text-muted">${m.providerZh} · 发布于 ${m.releaseDate}</div>
                </div>
                <span class="rounded-lg bg-white/5 px-2.5 py-1 font-mono text-sm font-bold text-neon-cyan">${m.arenaElo}</span>
              </div>

              <dl class="mt-4 grid grid-cols-2 gap-2.5 rounded-xl bg-white/[0.03] p-3 text-xs">
                <div>
                  <dt class="text-muted">编程 / 推理</dt>
                  <dd class="mt-0.5 font-mono font-semibold text-ink">${m.codingScore} / ${m.reasoningScore}</dd>
                </div>
                <div>
                  <dt class="text-muted">上下文窗口</dt>
                  <dd class="mt-0.5 font-mono font-semibold text-ink">${m.contextFormatted}</dd>
                </div>
                <div>
                  <dt class="text-muted">输入 / 输出价</dt>
                  <dd class="mt-0.5 font-mono font-semibold text-ink">${m.inputFormatted} / ${m.outputFormatted}</dd>
                </div>
                <div>
                  <dt class="text-muted">国内访问</dt>
                  <dd class="mt-0.5 font-medium text-slate-200">${m.chinaAccess}</dd>
                </div>
              </dl>

              <p class="mt-3 text-xs leading-relaxed text-slate-300"><strong class="text-ink">核心区别：</strong>${m.differenceNote}</p>
            </div>

            <div class="mt-4 flex items-center justify-between border-t border-white/5 pt-3 text-xs">
              <span class="text-muted">${m.modalities.join(' / ')}</span>
              <a href="/models/${m.slug}/" class="font-semibold text-neon-cyan hover:underline">查看完整评测 →</a>
            </div>
          </article>
        `,
          )
          .join('');
      }

      function applyFilterAndSort() {
        const q = state.search.trim().toLowerCase();
        const visible = [];

        rows.forEach((row) => {
          const okRegion = state.region === 'all' || row.dataset.region === state.region;
          const okLicense = state.license === 'all' || row.dataset.license === state.license;
          const okTier = state.tier === 'all' || row.dataset.tier === state.tier;
          const okSearch = !q || (row.dataset.search || '').includes(q);
          const show = okRegion && okLicense && okTier && okSearch;
          row.style.display = show ? '' : 'none';
          if (show) visible.push(row);
        });

        visible.sort((a, b) => {
          if (state.sort === 'coding-desc') return Number(b.dataset.coding) - Number(a.dataset.coding);
          if (state.sort === 'reasoning-desc') return Number(b.dataset.reasoning) - Number(a.dataset.reasoning);
          if (state.sort === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
          if (state.sort === 'context-desc') return Number(b.dataset.context) - Number(a.dataset.context);
          if (state.sort === 'date-desc') return (b.dataset.date || '').localeCompare(a.dataset.date || '');
          return Number(b.dataset.elo) - Number(a.dataset.elo);
        });

        if (tbody) {
          visible.forEach((row) => tbody.appendChild(row));
        }
        if (countEl) countEl.textContent = String(visible.length);
      }

      document.querySelectorAll('.filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.filter;
          const val = btn.dataset.value;
          if (!key || !val) return;
          state[key] = val;
          document.querySelectorAll(`.filter-btn[data-filter="${key}"]`).forEach((b) => {
            b.classList.toggle('is-active', b === btn);
          });
          applyFilterAndSort();
        });
      });

      searchInput?.addEventListener('input', (e) => {
        state.search = e.target.value || '';
        applyFilterAndSort();
      });

      sortSelect?.addEventListener('change', (e) => {
        state.sort = e.target.value || 'elo-desc';
        applyFilterAndSort();
      });

      checkboxes.forEach((cb) => {
        cb.addEventListener('change', () => {
          const slug = cb.value;
          if (cb.checked) {
            if (!selectedSlugs.includes(slug)) {
              if (selectedSlugs.length >= 3) selectedSlugs.shift();
              selectedSlugs.push(slug);
            }
          } else {
            selectedSlugs = selectedSlugs.filter((s) => s !== slug);
          }
          syncCheckboxes();
          renderCompare();
        });
      });

      resetBtn?.addEventListener('click', () => {
        selectedSlugs = [...defaultSelected];
        syncCheckboxes();
        renderCompare();
      });

      syncCheckboxes();
      renderCompare();
    })();
  </script>
</BaseLayout>
