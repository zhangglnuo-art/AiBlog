      </div>
    </section>

    <!-- 常见问题 FAQ（配合 FAQPage JSON-LD） -->
    <section class="mt-14">
      <span class="eyebrow">FAQ</span>
      <h2 class="mt-2 text-2xl font-bold text-ink">AI 大模型排行榜常见问题</h2>
      <div class="mt-5 space-y-3">
        {
          faqs.map((item) => (
            <details class="glass group rounded-2xl p-5" open>
              <summary class="cursor-pointer list-none font-semibold text-ink flex items-center justify-between gap-4">
                <span>{item.q}</span>
                <span class="text-neon-cyan transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-slate-300">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- 数据来源声明 -->
    <p class="mt-10 text-xs leading-relaxed text-muted">
      数据说明：{modelsDataset.source}。API 价格以 OpenRouter 公开目录（美元/百万 Token）为基准，不同云厂商、批处理（Batch）或缓存命中模式下可能存在折扣；Elo 与分项能力分为公开榜单综合参考值，实际选型建议结合自身业务集实测。
    </p>
