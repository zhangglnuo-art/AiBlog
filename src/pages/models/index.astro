  <script is:inline define:vars={{ comparePayload, wizardScenarios }}>
    (() => {
      const state = {
        region: 'all',
        license: 'all',
        tier: 'all',
        search: '',
        sort: 'elo-desc',
      };

      const wizardState = {
        scene: 'writing',
        access: 'all',
        budget: 'all',
      };

      const defaultSelected = ['gemini-4-carbon', 'claude-opus-5-5', 'deepseek-v4-pro'];
      let selectedSlugs = [...defaultSelected];
      let currentRecommendedSlugs = [...defaultSelected];

      const tbody = document.getElementById('leaderboard-tbody');
      const rows = Array.from(document.querySelectorAll('.model-row'));
      const countEl = document.getElementById('visible-count');
      const searchInput = document.getElementById('model-search');
      const sortSelect = document.getElementById('model-sort');
      const compareGrid = document.getElementById('compare-grid');
      const resetBtn = document.getElementById('compare-reset');
      const checkboxes = Array.from(document.querySelectorAll('.compare-checkbox'));

      const sceneButtons = Array.from(document.querySelectorAll('.scene-card'));
      const wizPills = Array.from(document.querySelectorAll('.wiz-pill'));
      const wizardCardsEl = document.getElementById('wizard-cards');
      const wizardTitleEl = document.getElementById('wizard-result-title');
      const wizardSubEl = document.getElementById('wizard-result-sub');
      const wizardSceneLink = document.getElementById('wizard-scene-link');
      const wizardCompareBtn = document.getElementById('wizard-compare-btn');
      const wizardClearBtn = document.getElementById('wizard-clear');

      const modelMap = new Map(comparePayload.map((m) => [m.slug, m]));
      const scenarioMap = new Map(wizardScenarios.map((s) => [s.slug, s]));

      // 支持 URL 参数 ?scene=ppt 等直接定位场景
      const urlScene = new URLSearchParams(window.location.search).get('scene');
      if (urlScene && scenarioMap.has(urlScene)) {
        wizardState.scene = urlScene;
      }

      function syncCheckboxes() {
        checkboxes.forEach((cb) => {
          cb.checked = selectedSlugs.includes(cb.value);
        });
      }

      function syncFilterButtonsUI() {
        document.querySelectorAll('.filter-btn').forEach((b) => {
          const key = b.dataset.filter;
          const val = b.dataset.value;
          b.classList.toggle('is-active', key && state[key] === val);
        });
      }

      function syncWizardUI() {
        sceneButtons.forEach((b) => {
          b.classList.toggle('is-active', b.dataset.scene === wizardState.scene);
        });
        wizPills.forEach((b) => {
          const key = b.dataset.wiz;
          const val = b.dataset.value;
          b.classList.toggle('is-active', key && wizardState[key] === val);
        });
      }

      function renderWizard() {
        const sc = scenarioMap.get(wizardState.scene) || wizardScenarios[0];
        if (!sc || !wizardCardsEl) return;

        let candidates = comparePayload
          .map((m) => {
            const evalRes = sc.scores[m.slug] || { matched: true, score: 80, reason: m.summary };
            let finalScore = evalRes.score;
            if (wizardState.budget === 'top') {
              finalScore += m.tier === 'flagship' ? 6 : m.tier === 'fast' ? -6 : 0;
            } else if (wizardState.budget === 'value') {
              const p = m.blendedPricePerM ?? 5;
              finalScore += p <= 0.6 ? 12 : p <= 2 ? 5 : p >= 8 ? -12 : -4;
            }
            return { model: m, ...evalRes, finalScore };
          })
          .filter((item) => item.matched);

        if (wizardState.access !== 'all') {
          candidates = candidates.filter((item) => item.model.region === wizardState.access);
        }
        if (wizardState.budget === 'open') {
          candidates = candidates.filter((item) => item.model.license === 'open-weight');
        }

        candidates.sort((a, b) => b.finalScore - a.finalScore || b.model.arenaElo - a.model.arenaElo);

        // 挑选 Top 3（当条件宽松时尽量提供：最佳首选 + 高性价比平替 + 国产直连首选）
        const picked = [];
        const used = new Set();
        const pushPick = (item, badge, badgeClass) => {
          if (!item || used.has(item.model.slug)) return;
          used.add(item.model.slug);
          picked.push({ ...item, badge, badgeClass });
        };

        if (candidates.length > 0) {
          pushPick(candidates[0], '🏆 场景最佳首选', 'text-neon-cyan');
        }
        if (candidates.length > 1) {
          const cheapAlt = [...candidates]
            .filter((c) => !used.has(c.model.slug))
            .sort((a, b) => (a.model.blendedPricePerM ?? 999) - (b.model.blendedPricePerM ?? 999))[0];
          if (cheapAlt && wizardState.budget !== 'top') {
            pushPick(cheapAlt, '💰 高性价比平替', 'text-amber-300');
          }
        }
        if (wizardState.access === 'all') {
          const chinaAlt = candidates.find((c) => !used.has(c.model.slug) && c.model.region === 'china');
          if (chinaAlt) pushPick(chinaAlt, '🇨🇳 国内直连首选', 'text-emerald-300');
        }
        for (const c of candidates) {
          if (picked.length >= 3) break;
          pushPick(c, '⭐ 强力备选', 'text-brand-300');
        }

        currentRecommendedSlugs = picked.map((p) => p.model.slug);

        if (wizardTitleEl) {
          wizardTitleEl.textContent = `${sc.icon} 「${sc.name}」为你匹配到 ${candidates.length} 款合适模型`;
        }
        if (wizardSubEl) {
          const accessTxt =
            wizardState.access === 'china' ? '仅国内直连' : wizardState.access === 'global' ? '仅海外模型' : '国内外不限';
          const budgetTxt =
            wizardState.budget === 'top'
              ? '追求最强上限'
              : wizardState.budget === 'value'
                ? '极致省钱优先'
                : wizardState.budget === 'open'
                  ? '开源权重可自部署'
                  : '综合均衡';
          wizardSubEl.textContent = `当前条件：${accessTxt} · ${budgetTxt}（下方完整榜单已联动过滤）`;
        }
        if (wizardSceneLink) {
          wizardSceneLink.href = sc.url;
          wizardSceneLink.classList.remove('hidden');
        }
        if (wizardClearBtn) {
          wizardClearBtn.classList.remove('hidden');
        }

        if (!picked.length) {
          wizardCardsEl.innerHTML =
            '<div class="col-span-full rounded-xl border border-white/10 bg-white/[0.02] p-5 text-center text-sm text-muted">当前组合条件过于严格，暂无完全匹配模型，建议放宽「预算」或「网络条件」试试。</div>';
          return;
        }

        wizardCardsEl.innerHTML = picked
          .map(
            (p) => `
          <div class="flex flex-col justify-between rounded-2xl border border-white/10 bg-surface/70 p-4">
            <div>
              <div class="flex items-center justify-between gap-2 text-xs">
                <span class="font-semibold ${p.badgeClass}">${p.badge}</span>
                <span class="font-mono text-muted">适配分 <strong class="text-ink">${p.score}</strong></span>
              </div>
              <div class="mt-2 flex items-center justify-between gap-2">
                <a href="/models/${p.model.slug}/" class="flex items-center gap-2 text-base font-bold text-ink hover:text-neon-cyan hover:underline">
                  <img src="${p.model.logo}" alt="${p.model.providerZh}" width="22" height="22" class="h-6 w-6 shrink-0 rounded-lg border border-white/10 bg-white/[0.06] p-1 object-contain" />
                  <span>${p.model.name}</span>
                </a>
                <span class="rounded-full bg-white/5 px-2 py-0.5 text-[11px] text-slate-300">${p.model.regionLabel}</span>
              </div>
              <div class="mt-1 text-xs text-muted">${p.model.providerZh} · ${p.model.inputFormatted} / ${p.model.outputFormatted} (1M)</div>
              <p class="mt-2.5 text-xs leading-relaxed text-slate-300">${p.reason}</p>
            </div>
            <div class="mt-3 flex items-center justify-between border-t border-white/5 pt-2.5 text-xs">
              <span class="text-muted">${p.model.contextFormatted} 上下文</span>
              <a href="/models/${p.model.slug}/" class="font-medium text-neon-cyan hover:underline">查看详情 →</a>
            </div>
          </div>
        `,
          )
          .join('');
      }

      function applyWizardToTable() {
        state.region = wizardState.access;
        state.license = wizardState.budget === 'open' ? 'open-weight' : 'all';
        state.tier = wizardState.budget === 'top' ? 'flagship' : 'all';
        if (wizardState.scene === 'coding') state.sort = 'coding-desc';
        else if (wizardState.scene === 'reasoning') state.sort = 'reasoning-desc';
        else if (wizardState.scene === 'cost-effective' || wizardState.budget === 'value') state.sort = 'price-asc';
        else if (wizardState.scene === 'long-doc') state.sort = 'context-desc';
        else state.sort = 'elo-desc';

        if (sortSelect) sortSelect.value = state.sort;
        syncFilterButtonsUI();
        applyFilterAndSort();
      }

      function renderCompare() {
        if (!compareGrid) return;
        const list = selectedSlugs.map((s) => modelMap.get(s)).filter(Boolean);
        if (!list.length) {
          compareGrid.innerHTML =
            '<div class="glass col-span-full rounded-2xl p-6 text-center text-sm text-muted">请在上方排行榜勾选 1–3 款模型进行对比。</div>';
          return;
        }
        compareGrid.innerHTML = list
          .map(
            (m) => `
          <article class="card flex flex-col justify-between p-5">
            <div>
              <div class="flex items-start justify-between gap-2">
                <div class="flex items-start gap-2.5">
                  <span class="mt-0.5 grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-white/10 bg-white/[0.06] p-1.5">
                    <img src="${m.logo}" alt="${m.providerZh}" width="24" height="24" class="h-6 w-6 object-contain" />
                  </span>
                  <div>
                    <span class="text-xs font-mono text-neon-cyan">#${m.rank} · ${m.regionLabel} · ${m.licenseLabel}</span>
                    <h3 class="mt-0.5 text-lg font-bold text-ink">
                      <a href="/models/${m.slug}/" class="hover:text-neon-cyan">${m.name}</a>
                    </h3>
                    <div class="text-xs text-muted">${m.providerZh} · 发布于 ${m.releaseDate}</div>
                  </div>
                </div>
                <span class="rounded-lg bg-white/5 px-2.5 py-1 font-mono text-sm font-bold text-neon-cyan">${m.arenaElo}</span>
              </div>

              <dl class="mt-4 grid grid-cols-2 gap-2.5 rounded-xl bg-white/[0.03] p-3 text-xs">
                <div>
                  <dt class="text-muted">编程 / 推理</dt>
                  <dd class="mt-0.5 font-mono font-semibold text-ink">${m.codingScore} / ${m.reasoningScore}</dd>
                </div>
                <div>
                  <dt class="text-muted">上下文窗口</dt>
                  <dd class="mt-0.5 font-mono font-semibold text-ink">${m.contextFormatted}</dd>
                </div>
                <div>
                  <dt class="text-muted">输入 / 输出价</dt>
                  <dd class="mt-0.5 font-mono font-semibold text-ink">${m.inputFormatted} / ${m.outputFormatted}</dd>
                </div>
                <div>
                  <dt class="text-muted">国内访问</dt>
                  <dd class="mt-0.5 font-medium text-slate-200">${m.chinaAccess}</dd>
                </div>
              </dl>

              <p class="mt-3 text-xs leading-relaxed text-slate-300"><strong class="text-ink">核心区别：</strong>${m.differenceNote}</p>
            </div>

            <div class="mt-4 flex items-center justify-between border-t border-white/5 pt-3 text-xs">
              <span class="text-muted">${m.modalities.join(' / ')}</span>
              <a href="/models/${m.slug}/" class="font-semibold text-neon-cyan hover:underline">查看完整评测 →</a>
            </div>
          </article>
        `,
          )
          .join('');
      }

      function applyFilterAndSort() {
        const q = state.search.trim().toLowerCase();
        const visible = [];

        rows.forEach((row) => {
          const okRegion = state.region === 'all' || row.dataset.region === state.region;
          const okLicense = state.license === 'all' || row.dataset.license === state.license;
          const okTier = state.tier === 'all' || row.dataset.tier === state.tier;
          const okSearch = !q || (row.dataset.search || '').includes(q);
          const show = okRegion && okLicense && okTier && okSearch;
          row.style.display = show ? '' : 'none';
          if (show) visible.push(row);
        });

        visible.sort((a, b) => {
          if (state.sort === 'coding-desc') return Number(b.dataset.coding) - Number(a.dataset.coding);
          if (state.sort === 'reasoning-desc') return Number(b.dataset.reasoning) - Number(a.dataset.reasoning);
          if (state.sort === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
          if (state.sort === 'context-desc') return Number(b.dataset.context) - Number(a.dataset.context);
          if (state.sort === 'date-desc') return (b.dataset.date || '').localeCompare(a.dataset.date || '');
          return Number(b.dataset.elo) - Number(a.dataset.elo);
        });

        if (tbody) {
          visible.forEach((row) => tbody.appendChild(row));
        }
        if (countEl) countEl.textContent = String(visible.length);
      }

      document.querySelectorAll('.filter-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.filter;
          const val = btn.dataset.value;
          if (!key || !val) return;
          state[key] = val;
          document.querySelectorAll(`.filter-btn[data-filter="${key}"]`).forEach((b) => {
            b.classList.toggle('is-active', b === btn);
          });
          applyFilterAndSort();
        });
      });

      searchInput?.addEventListener('input', (e) => {
        state.search = e.target.value || '';
        applyFilterAndSort();
      });

      sortSelect?.addEventListener('change', (e) => {
        state.sort = e.target.value || 'elo-desc';
        applyFilterAndSort();
      });

      checkboxes.forEach((cb) => {
        cb.addEventListener('change', () => {
          const slug = cb.value;
          if (cb.checked) {
            if (!selectedSlugs.includes(slug)) {
              if (selectedSlugs.length >= 3) selectedSlugs.shift();
              selectedSlugs.push(slug);
            }
          } else {
            selectedSlugs = selectedSlugs.filter((s) => s !== slug);
          }
          syncCheckboxes();
          renderCompare();
        });
      });

      resetBtn?.addEventListener('click', () => {
        selectedSlugs = [...defaultSelected];
        syncCheckboxes();
        renderCompare();
      });

      sceneButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const s = btn.dataset.scene;
          if (!s) return;
          wizardState.scene = s;
          if (s === 'china-direct') wizardState.access = 'china';
          syncWizardUI();
          renderWizard();
          applyWizardToTable();
        });
      });

      wizPills.forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.dataset.wiz;
          const val = btn.dataset.value;
          if (!key || !val) return;
          wizardState[key] = val;
          syncWizardUI();
          renderWizard();
          applyWizardToTable();
        });
      });

      wizardCompareBtn?.addEventListener('click', () => {
        if (!currentRecommendedSlugs.length) return;
        selectedSlugs = [...currentRecommendedSlugs];
        syncCheckboxes();
        renderCompare();
        document.getElementById('compare-section')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });

      wizardClearBtn?.addEventListener('click', () => {
        wizardState.scene = 'writing';
        wizardState.access = 'all';
        wizardState.budget = 'all';
        state.region = 'all';
        state.license = 'all';
        state.tier = 'all';
        state.search = '';
        state.sort = 'elo-desc';
        if (searchInput) searchInput.value = '';
        if (sortSelect) sortSelect.value = 'elo-desc';
        syncWizardUI();
        syncFilterButtonsUI();
        renderWizard();
        applyFilterAndSort();
      });

      syncWizardUI();
      renderWizard();
      if (urlScene && scenarioMap.has(urlScene)) {
        applyWizardToTable();
      }
      syncCheckboxes();
      renderCompare();
    })();
  </script>
</BaseLayout>
